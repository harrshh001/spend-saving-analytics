generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model SpendRecord {
  id            Int      @id @default(autoincrement())
  date          DateTime
  department    String
  category      String
  vendor        String
  location      String
  businessUnit  String
  budget        Float
  actualSpend   Float
  status        String
  priority      String
  paymentMethod String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
